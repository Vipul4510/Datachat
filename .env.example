# DataChat Environment Configuration Template
# Copy this file to .env and configure your desired credentials.

# 1. Groq (LPU Inference - Fast & Free Tier Available)
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini (Official Generative Language API)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 3. xAI Grok (Official xAI API)
# Get a key at: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-2-latest

# 4. Ollama (Optional Local Offline Engine)
# Download from: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 5. Application Engine Settings
DEFAULT_PROVIDER=auto
MAX_RETRIES=1
MAX_ROW_LIMIT=500
QUERY_TIMEOUT_SECONDS=15.0
MAX_FILE_SIZE_MB=200
